---
import Section from "../Section.astro";
import HTML from "@/icons/html.astro";
import CSS from "@/icons/css.astro";
import JavaScript from "@/icons/javascript.astro";
import TypeScript from "@/icons/type.astro";
import React from "@/icons/react.astro";
import Node from "@/icons/node.astro";
import MySQL from "@/icons/sql.astro";
import Git from "@/icons/git.astro";
import GitHub from "@/icons/GitHub.astro";
import Tailwind from "@/icons/tailwind.astro";
import Python from "@/icons/python.astro";
import C from "@/icons/c.astro";
import Cpp from "@/icons/cpp.astro";
import PostgreSQL from "@/icons/postgresql.astro";
import ROS from "@/icons/ros.astro";
import Go from "@/icons/go.astro";
import Docker from "@/icons/docker.astro";
import { skills } from "@skills";

const SKILLS_ICONS: Record<string, any> = {
	html: HTML,
	css: CSS,
	javascript: JavaScript,
	type: TypeScript,
	react: React,
	node: Node,
	sql: MySQL,
	git: Git,
	GitHub: GitHub,
	tailwind: Tailwind,
	python: Python,
	c: C,
	cpp: Cpp,
	postgresql: PostgreSQL,
	ros: ROS,
	go: Go,
	docker: Docker,
};

// Group skills by category
const skillsByCategory = skills.reduce(
	(acc, skill) => {
		const category = skill.category || "Other";
		if (!acc[category]) acc[category] = [];
		acc[category].push(skill);
		return acc;
	},
	{} as Record<string, typeof skills>
);

// Category colors for visual distinction
const categoryColors: Record<string, { bg: string; text: string }> = {
	Frontend: { bg: "bg-blue-500/10", text: "text-blue-400" },
	Backend: { bg: "bg-green-500/10", text: "text-green-400" },
	DevOps: { bg: "bg-purple-500/10", text: "text-purple-400" },
	Robotics: { bg: "bg-red-500/10", text: "text-red-400" },
	Other: { bg: "bg-skin-button-muted/50", text: "text-skin-hue" },
};
---

<Section className={Astro.props.className} title="Skills">
	<div class="space-y-8">
		{
			Object.entries(skillsByCategory).map(([category, categorySkills], catIndex) => {
				const colors = categoryColors[category] || categoryColors["Other"];
				return (
					<div
						data-stagger={catIndex + 1}
						class="space-y-4 animate-fade-in-up"
					>
						<div class={`inline-flex items-center gap-3 rounded-xl ${colors.bg} px-4 py-3 backdrop-blur-sm border border-current border-opacity-20`}>
							<h3 class={`text-sm font-bold uppercase tracking-widest ${colors.text}`}>
								{category}
							</h3>
							<span class={`px-2.5 py-0.5 rounded-lg bg-current bg-opacity-10 text-xs font-semibold ${colors.text}`}>
								{categorySkills.length}
							</span>
						</div>

						<div class="grid grid-cols-1 gap-2 md:grid-cols-2 lg:grid-cols-3">
							{categorySkills.map((skill, index) => {
								const Icon = SKILLS_ICONS[skill.icon];
								return (
									<div
										data-stagger={index + 1}
										class="skill-card group relative flex items-center gap-3 rounded-xl bg-gradient-to-br from-skin-button-muted/50 to-skin-button-muted/20 p-4 ring-1 ring-skin-muted/40 transition-all duration-300 hover:ring-skin-hue/60 hover:-translate-y-1 hover:shadow-xl hover:from-skin-button-muted/70 hover:to-skin-button-muted/40"
									>
										{Icon && (
											<div class="skill-icon flex h-10 w-10 items-center justify-center rounded-xl bg-skin-hue/10 text-skin-hue ring-1 ring-skin-hue/20">
												<Icon />
											</div>
										)}
										<h4 class="text-sm font-semibold text-skin-base">
											{skill.name}
										</h4>
									</div>
								);
							})}
						</div>
					</div>
				);
			})
		}
	</div>
</Section>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const staggerElements = document.querySelectorAll("[data-stagger]");
		staggerElements.forEach((el) => {
			const stagger = Number(el.getAttribute("data-stagger") ?? "1");
			const delay = (stagger - 1) * 0.1;
			(el as HTMLElement).style.animationDelay = `${delay}s`;
		});
	});
</script>

