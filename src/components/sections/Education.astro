---
import Section from "../Section.astro";

import { education } from "@education";
// import { certificates } from "@education";
---

<Section className={Astro.props.className} title="Education">
	<ul class="space-y-4 py-3 print:space-y-0">
		{
			education.map(({ institution, startDate, endDate, url, ongoing }, index) => {
				const startYear = new Date(startDate).getFullYear();
				const endYear = endDate && endDate !== "" ? new Date(endDate).getFullYear() : "Present";
				const years = `${startYear} - ${endYear}`;
				const isCurrentStudy = ongoing || endYear === "Present";

				return (
					<div class="education-card group relative rounded-xl bg-gradient-to-br from-skin-button-muted/50 to-skin-button-muted/20 p-5 ring-1 ring-skin-muted/40 transition-all duration-300 hover:ring-skin-hue/60 hover:bg-skin-button-muted/50 hover:-translate-y-2 hover:shadow-xl animate-fade-in-up">
						<div class="flex items-start justify-between gap-2">
							<div class="flex items-start gap-3 flex-1">
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-1 h-5 w-5 text-skin-hue shrink-0 transition-transform duration-300 group-hover:scale-110">
									<path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z" />
									<path d="M22 10v6" />
									<path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5" />
								</svg>
								<div class="flex-1 min-w-0">
									<div class="flex items-center gap-2 flex-wrap">
										<h3 class="font-semibold text-skin-base">
											<a target="_blank" class="hover:text-skin-hue transition-colors decoration-dotted underline-offset-[5px] hover:underline" href={url}>
												{institution}
											</a>
										</h3>
										{isCurrentStudy && (
											<span class="inline-flex rounded-full bg-green-500/20 px-2 py-0.5 text-xs font-semibold text-green-400 animate-pulse">
												Ongoing
											</span>
										)}
									</div>
								</div>
							</div>

							<time class="text-xs text-skin-muted shrink-0 whitespace-nowrap">{years}</time>
						</div>
					</div>
				);
			})
		}
	</ul>
</Section>
